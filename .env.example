# =============================================================================
# VINCI ENV
# Copy to .env. Every value is optional; the defaults build and run Vinci.
# Shell variables win over this file.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Product name shown in the apps, notifications, OAuth screens and bot instructions.
APP_NAME=Vinci
VITE_APP_NAME=Vinci
# Data root for the database, bot stores and logs.
DATA_DIR=~/.config/vinci/
# debug | info | warn | error
LOG_LEVEL=info
# Pi agent directory: provider logins (auth.json), custom endpoints (models.json), skills and instructions. Read by Pi.
# PI_CODING_AGENT_DIR=~/.pi/agent

# -----------------------------------------------------------------------------
# Daemon
# -----------------------------------------------------------------------------
DAEMON_HOST=0.0.0.0
DAEMON_PORT=3000
# Extra browser origins allowed to call the daemon, comma separated.
DAEMON_ALLOWED_ORIGINS=
# Public origins clients reach this daemon at, comma separated. When set, the daemon advertises only these
# (and owner-added custom addresses) instead of detected loopback, LAN and Tailscale addresses, and allows them as Origins.
DAEMON_PUBLIC_URLS=
# Docker installs: the folder this daemon shares with the person's sandbox container. When set, bot tools (read,
# write, edit, bash) run only in the sandbox through pi-env; without a connected sandbox every tool call is refused.
# Unset (development, a native daemon): tools run in the daemon.
# DAEMON_SANDBOX_DIR=/run/sandbox

# -----------------------------------------------------------------------------
# Web
# -----------------------------------------------------------------------------
WEB_HOST=127.0.0.1
WEB_PORT=47190
# Origin the pairing link opens; the code inside it carries every daemon address.
WEB_PUBLIC_URL=http://127.0.0.1:47190
# Hub mode: the hub's internal origin. Server-side daemon calls go to the hub with the request's login cookie,
# and the web server stops proxying daemon paths, which the hub routes itself.
WEB_HUB_URL=

# -----------------------------------------------------------------------------
# Hub (team installs: one public hostname behind Caddy and the Laravel login, one daemon per user)
# -----------------------------------------------------------------------------
HUB_HOST=127.0.0.1
HUB_PORT=47192
# Holds users.json (email -> user, daemon URL, owner socket), admins.json and the pinned daemon server IDs.
HUB_DATA_DIR=~/.config/vinci-hub/
# The web app every non-daemon path goes to.
HUB_WEB_URL=http://127.0.0.1:47190
# Required by the hub: the organization's public origin, sent upstream as X-Forwarded-Proto and X-Forwarded-Host.
HUB_PUBLIC_URL=
# Required by the hub: the Laravel API that checks each login (the vinci_session cookie), and its internal token.
HUB_ACCOUNTS_URL=
HUB_ACCOUNTS_TOKEN=
# Comma-separated emails that seed admins.json (the /admin panel's admin list) while it is empty.
HUB_ADMIN_EMAILS=
# The provisioner (team stack) that owns users.yaml and the containers. Unset on a by-hand install:
# user changes from the admin panel then answer 501.
PROVISIONER_URL=
PROVISIONER_TOKEN=

# -----------------------------------------------------------------------------
# Mobile (iOS)
# APP_VARIANT (development | preview | production) adds " Dev"/" Preview" to the name,
# "-dev"/"-preview" to the scheme and ".dev"/".preview" to the bundle ID.
# EAS cloud builds do not upload .env: set the same values with `eas env:create`.
# -----------------------------------------------------------------------------
# The notification extension and app group derive from this ID.
MOBILE_BUNDLE_ID=pt.entrypoint.vinci
MOBILE_SCHEME=vinci
# Apple Developer team that signs the app and its notification extension.
MOBILE_APPLE_TEAM_ID=
# Expo account, slug and project ID (from `eas init`); needed for push notifications.
MOBILE_EAS_OWNER=
MOBILE_EAS_SLUG=vinci
MOBILE_EAS_PROJECT_ID=

# -----------------------------------------------------------------------------
# Desktop (macOS)
# -----------------------------------------------------------------------------
DESKTOP_BUNDLE_ID=pt.entrypoint.vinci.desktop
DESKTOP_VERSION=0.0.0
# Built into the app. Empty: ~/.config/vinci/ and ports from 47190 (its daemon 100 higher). A test build sets its own
# so it never shares data or ports with dev servers or another build; see docs/desktop-release.md.
DESKTOP_DATA_DIR=
DESKTOP_PORT=

# -----------------------------------------------------------------------------
# Desktop release (bun run release:desktop)
# -----------------------------------------------------------------------------
# Dedicated keychain holding the Developer ID Application certificate.
DESKTOP_SIGNING_KEYCHAIN=
# SHA-1 fingerprint of that certificate.
DESKTOP_SIGNING_IDENTITY=
# Optional when a credentials.json beside the keychain has releaseKeychainPassword, apiKeyId and apiIssuerId.
DESKTOP_SIGNING_KEYCHAIN_PASSWORD=
DESKTOP_NOTARY_KEY_ID=
DESKTOP_NOTARY_ISSUER=
# Defaults to AuthKey_<key id>.p8 beside the keychain.
DESKTOP_NOTARY_KEY_PATH=
# Where installed apps look for updates (https, no ?query; a key goes in the path). A release with --desktop requires it; a build
# without it has updates off. See docs/desktop-release.md.
DESKTOP_UPDATE_URL=
# The bucket behind that address, which bun run publish:desktop uploads to (any S3-compatible storage; R2: region auto).
DESKTOP_UPDATE_S3_BUCKET=
DESKTOP_UPDATE_S3_ENDPOINT=
DESKTOP_UPDATE_S3_REGION=
DESKTOP_UPDATE_S3_ACCESS_KEY_ID=
DESKTOP_UPDATE_S3_SECRET_ACCESS_KEY=

# Disposable Hetzner servers `bun scripts/test-server.ts` may rebuild (a rebuild wipes the disk), as
# name=address pairs, and the hcloud context that owns them.
TEST_SERVERS=
TEST_SERVERS_HCLOUD_CONTEXT=
