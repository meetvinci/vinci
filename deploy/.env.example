# /opt/orbs/.env on the server: every setting of a team install. Owned by root, mode 600: it holds secrets.
# Docker Compose reads it from /opt/orbs; `bun deploy.ts` runs there too. ORBS_PUBLIC_HOST, ACCESS_TEAM_DOMAIN,
# ACCESS_AUD and TUNNEL_TOKEN are in the Cloudflare block at the end.

# Load the base stack, the tunnel connector and the per-person file `bun deploy.ts apply` writes.
COMPOSE_FILE=compose.yaml:cloudflared.compose.yaml:users.compose.yaml

# Image tag of orbs-daemon, orbs-web and orbs-hub. Change it and run `docker compose up -d --wait` to upgrade.
ORBS_TAG=latest

# Limits per person's daemon. Keep 512m until memory is measured on the server.
DAEMON_MEMORY=512m
DAEMON_CPUS=1
DAEMON_PIDS=256

LOG_LEVEL=info

# Model API keys, given to every person's daemon as environment variables. Leave a provider empty to skip it.
# A key a person adds in Settings → Providers wins over these. Until Phase 6 every person's bots can read these keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# -----------------------------------------------------------------------------
# Cloudflare: written by `bun scripts/deploy.ts cloudflare apply --env-out <file>`
# and merged into /opt/orbs/.env (mode 600, root only). Do not edit by hand.
# ORBS_PUBLIC_HOST: the team hostname without https://, such as acme.example.com.
# ACCESS_TEAM_DOMAIN: https://<team>.cloudflareaccess.com. ACCESS_AUD: AUD tag of the team's Access application.
# TUNNEL_TOKEN: secret; lets cloudflared connect this server's tunnel.
# -----------------------------------------------------------------------------
ORBS_PUBLIC_HOST=
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
TUNNEL_TOKEN=
