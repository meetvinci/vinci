# /opt/vinci/.env on the server: every setting of a team install. Owned by root, mode 600: it holds secrets.
# Docker Compose reads it from /opt/vinci; `bun deploy.ts` runs there too. VINCI_PUBLIC_HOST, ACCESS_TEAM_DOMAIN,
# ACCESS_AUD and TUNNEL_TOKEN are in the Cloudflare block at the end.

# Load the base stack, the tunnel connector and the per-person file `bun deploy.ts apply` writes.
COMPOSE_FILE=compose.yaml:cloudflared.compose.yaml:users.compose.yaml

# Where the images come from: Vinci's public images on GitHub Container Registry, ending in /. No `docker login`
# needed. Empty uses images loaded by hand (`docker load`).
VINCI_REGISTRY=ghcr.io/meetvinci/
# Image tag of every vinci-* image, a release such as v0.2.0. Change it, `docker compose pull`, then
# `docker compose up -d --wait` to upgrade.
VINCI_TAG=latest

# Limits per person's daemon. Keep 512m until memory is measured on the server.
DAEMON_MEMORY=512m
DAEMON_CPUS=1
DAEMON_PIDS=256
# Each person's sandbox, where their bots' tools run (deploy/compose/sandbox.yaml).
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1
SANDBOX_PIDS=256
# The disk of each person's bots: their bot folders, what the kernel lets them write before "No space left on device".
# Sparse, so it takes only what is written; grow it here and run `bun deploy.ts apply` (shrinking is not automatic).
# People times this should fit the server's free space: apply warns when it does not.
SANDBOX_DISK=5g

LOG_LEVEL=info

# Bots reach the public internet but no internal address (the firewall service). To let every person's daemon reach
# one internal service anyway, name it here: comma-separated <IPv4>:<port>, TCP, such as 172.17.0.1:48290 for a test
# model on the Docker bridge gateway. Empty: nothing internal. Run `bun deploy.ts apply` after changing it.
VINCI_INTERNAL_ALLOW=

# The admin panel. HUB_ADMIN_EMAILS: the first admins, comma separated; the hub uses them while its own admin list is
# empty. PROVISIONER_TOKEN: secret, `openssl rand -hex 32` at install; the hub sends it to the provisioner, the only
# container with the Docker socket. Nobody types it.
HUB_ADMIN_EMAILS=
PROVISIONER_TOKEN=

# PostgreSQL passwords generated at install. Laravel uses the vinci database owner's password.
VINCI_DB_PASSWORD=
VINCI_POSTGRES_PASSWORD=

# Model API keys, given to every person's daemon as environment variables. Leave a provider empty to skip it.
# A key a person adds in Settings → Providers wins over these. Bots never see them: their tools run in the sandbox, which has none.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# -----------------------------------------------------------------------------
# Cloudflare: written by `bun scripts/deploy.ts cloudflare apply --env-out <file>`
# and merged into /opt/vinci/.env (mode 600, root only). Do not edit by hand.
# VINCI_PUBLIC_HOST: the team hostname without https://, such as acme.example.com.
# ACCESS_TEAM_DOMAIN: https://<team>.cloudflareaccess.com. ACCESS_AUD: AUD tag of the team's Access application.
# CLOUDFLARE_ZONE, CLOUDFLARE_NAME: the --zone and --name of the install, for the provisioner's Access sync.
# CLOUDFLARE_ACCESS_DOMAINS: the --domain values, comma-separated; empty when Access allows a list of emails.
# TUNNEL_TOKEN: secret; lets cloudflared connect this server's tunnel.
# -----------------------------------------------------------------------------
VINCI_PUBLIC_HOST=
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
CLOUDFLARE_ZONE=
CLOUDFLARE_NAME=
CLOUDFLARE_ACCESS_DOMAINS=
TUNNEL_TOKEN=

# Nightly backups (`bun deploy.ts nightly install`). BACKUP_TIME: server time, default 03:00; run install again after
# changing it. BACKUP_KEEP_DAILY, BACKUP_KEEP_WEEKLY: default 7 and 4, on the server and in the bucket.
BACKUP_TIME=
BACKUP_KEEP_DAILY=
BACKUP_KEEP_WEEKLY=
# Off-site copy to an S3-compatible bucket (admin.md, Off-site copy), off while BACKUP_S3_BUCKET is empty. Leave the
# endpoint empty for Amazon S3; R2: https://<account id>.r2.cloudflarestorage.com with region auto; B2: the bucket's
# S3 endpoint and its region. BACKUP_PASSPHRASE encrypts every upload (openssl rand -hex 32, at least 20 characters):
# keep it in your password manager too, since without it the off-site copies cannot be restored.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_PASSPHRASE=

# Optional, secret: lets the provisioner update the Access allow policy itself when the admin panel adds, disables or
# removes someone, or changes the admins, and shows in the panel whom Access lets in. Without it the panel tells the
# admin to change the policy by hand (never needed for people inside CLOUDFLARE_ACCESS_DOMAINS).
# A token with only Zone: Zone: Read for the domain and Account: Access: Apps and Policies: Edit (Read is enough to
# only show the state); not the install token.
CLOUDFLARE_API_TOKEN=
