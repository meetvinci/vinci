# -----------------------------------------------------------------------------
# Cloudflare: written by `bun scripts/deploy.ts cloudflare apply --env-out <file>`
# and merged into /opt/orbs/.env (mode 600, root only). Do not edit by hand.
# -----------------------------------------------------------------------------
# The team hostname, without https://, such as acme.example.com.
ORBS_PUBLIC_HOST=
# https://<team>.cloudflareaccess.com; the hub's ACCESS_TEAM_DOMAIN.
ACCESS_TEAM_DOMAIN=
# AUD tag of the team's Access application; the hub's ACCESS_AUD.
ACCESS_AUD=
# Secret. Lets cloudflared connect this server's tunnel.
TUNNEL_TOKEN=
